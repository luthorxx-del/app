{
  "name": "sportstats-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/sportstats/vite.config.ts && esbuild server.ts --bundle --platform=node --format=cjs --external:express --external:pino --external:pino-http --external:cookie-parser --external:cors --external:pg --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-client-react": "*",
    "@workspace/api-server": "*",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "@workspace/sportstats": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "esbuild": "0.27.3",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
